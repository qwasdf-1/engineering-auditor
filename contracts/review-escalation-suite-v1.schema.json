{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-auditor.dev/contracts/review-escalation-suite-v1.schema.json",
  "title": "Engineering Auditor Review Escalation Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "thresholds", "template_matrices"],
  "properties": {
    "schema_version": { "const": 1 },
    "suite_id": { "type": "string", "minLength": 1 },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_complete_ensemble_runs",
        "minimum_useful_ensemble_runs",
        "minimum_template_cases",
        "maximum_suppressed_minority_targets",
        "require_nonincreasing_post_union_disagreement"
      ],
      "properties": {
        "minimum_complete_ensemble_runs": { "type": "integer", "minimum": 1 },
        "minimum_useful_ensemble_runs": { "type": "integer", "minimum": 1 },
        "minimum_template_cases": { "type": "integer", "minimum": 1 },
        "maximum_suppressed_minority_targets": { "const": 0 },
        "require_nonincreasing_post_union_disagreement": { "const": true }
      }
    },
    "template_matrices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_mismatch",
        "shared_root_cause",
        "recommendation_consolidation"
      ],
      "properties": {
        "lifecycle_mismatch": { "$ref": "#/$defs/template_matrix" },
        "shared_root_cause": { "$ref": "#/$defs/template_matrix" },
        "recommendation_consolidation": { "$ref": "#/$defs/template_matrix" }
      }
    }
  },
  "$defs": {
    "template_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_probe_slots", "allowed_conclusions", "allowed_closures"],
      "properties": {
        "required_probe_slots": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowed_conclusions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowed_closures": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
