{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-auditor.dev/contracts/engineering-claim-v1.schema.json",
  "title": "Engineering Claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "case_id",
    "slot",
    "kind",
    "proposition",
    "status",
    "supporting_probe_ids",
    "counter_probe_ids",
    "dependency_claim_ids",
    "assumptions",
    "confidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "claim_id": { "type": "string", "pattern": "^engineering-claim:[0-9a-f]{64}$" },
    "case_id": { "type": "string", "pattern": "^engineering-case:[0-9a-f]{64}$" },
    "slot": {
      "enum": [
        "repetition",
        "input_equivalence",
        "mutation_boundary",
        "material_impact",
        "consumer_requirement",
        "wider_owner",
        "invalidation_feasibility",
        "retention_risk",
        "lifecycle_conclusion",
        "responsibility",
        "causal_overlap",
        "independent_actionability",
        "coupling_risk",
        "remediation_boundary",
        "compatibility",
        "abstraction_level",
        "supersession",
        "property_conflict",
        "required_ordering",
        "proportionality",
        "deferral"
      ]
    },
    "kind": {
      "enum": ["root_cause", "actionability", "recommendation_premise", "expected_benefit"]
    },
    "proposition": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "substantiated",
        "partially_substantiated",
        "not_substantiated",
        "blocked",
        "contested"
      ]
    },
    "supporting_probe_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/probe_id" }
    },
    "counter_probe_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/probe_id" }
    },
    "dependency_claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^engineering-claim:[0-9a-f]{64}$" }
    },
    "assumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence": { "enum": ["low", "medium", "high"] }
  },
  "$defs": {
    "probe_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[0-9a-f]{64}$"
    }
  }
}
