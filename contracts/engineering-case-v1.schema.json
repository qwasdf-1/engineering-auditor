{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-auditor.dev/contracts/engineering-case-v1.schema.json",
  "title": "Engineering Auditor Engineering Case V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_kind",
    "template_version",
    "template_status",
    "template_bundle_digest",
    "input_binding_id",
    "candidate_id",
    "decision_kind",
    "subject_ids",
    "finding_ids",
    "selection_provenance_refs",
    "evidence_contract",
    "operator_constraints",
    "claim_slots",
    "recommendation_families"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "case_id": { "type": "string", "pattern": "^engineering-case:[0-9a-f]{64}$" },
    "case_kind": { "enum": ["lifecycle_mismatch", "shared_root_cause", "recommendation_consolidation"] },
    "template_version": { "type": "integer", "const": 1 },
    "template_status": { "enum": ["production", "shadow", "not_enabled"] },
    "template_bundle_digest": { "$ref": "#/$defs/digest" },
    "input_binding_id": { "type": "string", "pattern": "^review-input:[0-9a-f]{64}$" },
    "candidate_id": { "type": "string", "pattern": "^review-candidate:[0-9a-f]{64}$" },
    "decision_kind": { "enum": ["evaluate_lifecycle_ownership", "evaluate_shared_root_cause", "reconcile_recommendations"] },
    "subject_ids": { "$ref": "#/$defs/nonempty_string_set" },
    "finding_ids": { "$ref": "#/$defs/nonempty_string_set" },
    "selection_provenance_refs": { "$ref": "#/$defs/nonempty_string_set" },
    "evidence_contract": {
      "$ref": "case-template-v1.schema.json#/$defs/evidence_contract"
    },
    "operator_constraints": { "$ref": "#/$defs/operator_constraints" },
    "claim_slots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "case-template-v1.schema.json#/$defs/claim_slot" }
    },
    "recommendation_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "case-template-v1.schema.json#/$defs/recommendation_family" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonempty_string_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "risk_level": { "enum": ["low", "moderate", "high", "critical"] },
    "risk_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_tolerance", "operational_criticality", "security_sensitivity"],
      "properties": {
        "change_tolerance": { "$ref": "#/$defs/risk_level" },
        "operational_criticality": { "$ref": "#/$defs/risk_level" },
        "security_sensitivity": { "$ref": "#/$defs/risk_level" }
      }
    },
    "operator_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_ids", "risk_posture", "excluded_domains"],
      "properties": {
        "constraint_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "risk_posture": {
          "oneOf": [
            { "$ref": "#/$defs/risk_posture" },
            { "type": "null" }
          ]
        },
        "excluded_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
