{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-auditor.dev/contracts/review-usefulness-v1.schema.json",
  "title": "Engineering Auditor Review Usefulness Sheet v1",
  "description": "Usefulness scores for one engineering review (`review rubric` writes it unscored): one item per answered claim and recommendation, each scored correct, specific, actionable, and novel (not already stated by a finding); an item is useful when all four hold. A model's score is a pre_label until a second, different model agrees (corroborated) or a person scores it (final); a disagreeing check is a dispute only a person settles. Only corroborated and final items count. No scoring model may be one the review ran on.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_digest", "source_digest", "items"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "review_digest": { "type": "string", "description": "The scored review record's canonical-JSON digest." },
    "source_digest": { "type": "string" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "scorer": { "type": "string", "pattern": "^(human|model):.+$" },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correct", "specific", "actionable", "novel"],
      "properties": {
        "correct": { "type": "boolean" },
        "specific": { "type": "boolean" },
        "actionable": { "type": "boolean" },
        "novel": { "type": "boolean", "description": "Not already stated by a finding." }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "question_id", "question_kind", "item", "text", "evidence_ids", "status"],
      "properties": {
        "item_id": { "type": "string" },
        "question_id": { "type": "string", "pattern": "^engineering-case:" },
        "question_kind": { "enum": ["hotspot_assessment", "shared_root_cause", "architecture_review", "remediation_plan"] },
        "item": { "enum": ["claim", "recommendation"] },
        "text": { "type": "string" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "patch_verdict": { "type": ["string", "null"], "enum": ["verified", "refuted", "unchecked", null] },
        "status": { "enum": ["pending", "pre_label", "corroborated", "final"] },
        "scores": { "oneOf": [{ "$ref": "#/$defs/scores" }, { "type": "null" }] },
        "scorer": { "oneOf": [{ "$ref": "#/$defs/scorer" }, { "type": "null" }] },
        "reason": { "type": ["string", "null"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scorer", "scores", "reason"],
            "properties": {
              "scorer": { "$ref": "#/$defs/scorer" },
              "scores": { "$ref": "#/$defs/scores" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
