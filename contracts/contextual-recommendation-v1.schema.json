{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-auditor.dev/contracts/contextual-recommendation-v1.schema.json",
  "title": "Contextual Recommendation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recommendation_id",
    "case_id",
    "family",
    "summary",
    "scope_ids",
    "premise_claim_ids",
    "affected_finding_ids",
    "detector_advice_relationship",
    "preconditions",
    "expected_benefits",
    "risks",
    "costs",
    "alternatives",
    "no_alternative_reason",
    "verification_steps",
    "materiality",
    "materiality_basis",
    "confidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "recommendation_id": {
      "type": "string",
      "pattern": "^contextual-recommendation:[0-9a-f]{64}$"
    },
    "case_id": { "type": "string", "pattern": "^engineering-case:[0-9a-f]{64}$" },
    "family": {
      "enum": [
        "lifecycle_reownership", "explicit_retention_avoidance", "measurement_before_change",
        "shared_root_remediation", "preserve_independent_actions", "consolidated_remediation",
        "sequenced_remediation", "narrowed_remediation", "deferred_remediation"
      ]
    },
    "summary": { "type": "string", "minLength": 1 },
    "scope_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "premise_claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^engineering-claim:[0-9a-f]{64}$" }
    },
    "affected_finding_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "detector_advice_relationship": {
      "enum": [
        "preserves",
        "consolidates",
        "narrows",
        "sequences",
        "defers",
        "not_actionable_with_current_evidence"
      ]
    },
    "preconditions": { "$ref": "#/$defs/nonempty_strings" },
    "expected_benefits": {
      "type": "array",
      "items": { "$ref": "#/$defs/benefit" }
    },
    "risks": { "$ref": "#/$defs/nonempty_strings" },
    "costs": { "$ref": "#/$defs/nonempty_strings" },
    "alternatives": {
      "type": "array",
      "items": { "$ref": "#/$defs/alternative" }
    },
    "no_alternative_reason": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "verification_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/verification" }
    },
    "materiality": { "enum": ["low", "medium", "high"] },
    "materiality_basis": { "type": "string", "minLength": 1 },
    "confidence": { "enum": ["low", "medium", "high"] }
  },
  "$defs": {
    "probe_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[0-9a-f]{64}$"
    },
    "nonempty_strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "benefit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "evidence_mode",
        "numeric_value",
        "unit",
        "extrapolation_model",
        "evidence_probe_ids"
      ],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "evidence_mode": {
          "enum": [
            "direct_measurement",
            "bounded_extrapolation",
            "structural_inference",
            "qualitative_only",
            "unknown"
          ]
        },
        "numeric_value": {
          "anyOf": [
            { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
            { "type": "null" }
          ]
        },
        "unit": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "extrapolation_model": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "evidence_probe_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/probe_id" }
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "tradeoffs"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "tradeoffs": { "$ref": "#/$defs/nonempty_strings" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "expected_observation", "evidence_probe_ids"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "expected_observation": { "type": "string", "minLength": 1 },
        "evidence_probe_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/probe_id" }
        }
      }
    }
  }
}
