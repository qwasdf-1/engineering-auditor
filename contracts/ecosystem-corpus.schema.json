{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-auditor.local/contracts/ecosystem-corpus.schema.json",
  "title": "Engineering Auditor Ecosystem Corpus Manifest",
  "description": "Pinned open-source repositories used to measure detector precision: the library corpus, and application repositories for detectors the libraries cannot measure. Checkouts are fetched on demand and never vendored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repositories"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repository"
      },
      "description": "Application repositories; each names its detectors."
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "url",
        "tag",
        "commit",
        "license",
        "source_files",
        "source_lines"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "language": {
          "enum": [
            "rust",
            "python",
            "typescript",
            "javascript",
            "go",
            "java",
            "kotlin",
            "csharp",
            "c",
            "cpp",
            "ruby",
            "julia",
            "shell"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+$"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "description": "SPDX license expression."
        },
        "source_files": {
          "type": "integer",
          "minimum": 1,
          "description": "Tracked files of the primary language at the pinned commit, excluding vendored directories."
        },
        "source_lines": {
          "type": "integer",
          "minimum": 1,
          "description": "Lines in those files at the pinned commit."
        },
        "detectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "description": "Application repositories only: the detectors this repository measures; scans keep only their findings."
        }
      }
    }
  }
}
