{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-auditor.dev/contracts/review-qualification-corpus-v1.schema.json",
  "title": "Engineering Auditor Review Qualification Corpus v1",
  "description": "What a route qualifies on: real repositories from the ecosystem corpus (pinned in eval/ecosystem/manifest.json), the configuration every run must use, by file digest, the runs per repository, the stability policy, and the usefulness threshold (null until set from the first measured runs). The protocol suite keeps the generated lifecycle repositories as a regression of the review mechanics, not as qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "bindings", "route_sets", "repositories", "run_plan", "stability", "usefulness", "protocol_suite"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "corpus_id": { "type": "string" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_templates", "prompt_bundle", "brief"],
      "properties": {
        "question_templates": { "$ref": "#/$defs/binding" },
        "prompt_bundle": { "$ref": "#/$defs/binding" },
        "brief": { "$ref": "#/$defs/binding" }
      }
    },
    "route_sets": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/binding" } },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice", "ids"],
      "properties": {
        "slice": { "enum": ["library", "applications"] },
        "ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } }
      }
    },
    "run_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs_per_repository", "window_days", "check_patches", "max_patch_checks"],
      "properties": {
        "runs_per_repository": { "type": "integer", "minimum": 2 },
        "window_days": { "type": "integer", "minimum": 1 },
        "check_patches": { "type": "boolean" },
        "max_patch_checks": { "type": "integer", "minimum": 0 }
      }
    },
    "stability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "min_overlap"],
      "properties": {
        "top": { "type": "integer", "minimum": 1 },
        "min_overlap": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "usefulness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold"],
      "properties": {
        "threshold": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Useful share of counted items a route must reach; null until the first measured runs set it." }
      }
    },
    "protocol_suite": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fixture_kind", "generator", "generator_digest", "source_digest"],
        "properties": {
          "id": { "type": "string" },
          "fixture_kind": { "type": "string" },
          "generator": { "type": "string" },
          "generator_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
