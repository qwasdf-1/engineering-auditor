{
  "schema_version": 1,
  "bundle_version": 2,
  "entries": [
    {
      "kind": "lifecycle_mismatch",
      "version": 1,
      "status": "production",
      "template": {
        "schema_version": 2,
        "kind": "lifecycle_mismatch",
        "version": 1,
        "trigger": {
          "decision_kind": "evaluate_lifecycle_ownership",
          "selection_reasons_any": [
            "repeated_work_lifecycle_intersection"
          ]
        },
        "subject_policy": {
          "minimum_subjects": 1,
          "require_connected": true,
          "allow_multiple_findings": true
        },
        "evidence_contract": {
          "required": [
            {
              "id": "finding_records",
              "evidence_class": "finding",
              "description": "Immutable deterministic findings selected for the lifecycle decision."
            },
            {
              "id": "subject_neighborhood",
              "evidence_class": "evidence_graph",
              "description": "The connected subject and support neighborhood for the selected findings."
            },
            {
              "id": "source_role",
              "evidence_class": "source_role",
              "description": "Production, test, fixture, tooling, or documentation role for the repeated work."
            }
          ],
          "optional": [
            {
              "id": "source_spans",
              "evidence_class": "source_span",
              "description": "Hash-validated source excerpts inside the case neighborhood."
            },
            {
              "id": "runtime_measurement",
              "evidence_class": "runtime_measurement",
              "description": "Bound measurements of frequency, cost, allocation, or resource use."
            },
            {
              "id": "operator_constraints",
              "evidence_class": "operator_constraint",
              "description": "Bound operator constraints relevant to ownership and retention."
            }
          ],
          "blocking": [
            {
              "id": "relevant_mutation",
              "evidence_class": "mutation",
              "description": "Mutation that can invalidate equivalence across repeated executions."
            },
            {
              "id": "distinct_consumer_requirements",
              "evidence_class": "consumer_requirement",
              "description": "Consumer-specific inputs, configuration, freshness, or result requirements."
            },
            {
              "id": "retention_constraints",
              "evidence_class": "retention_constraint",
              "description": "Memory, privacy, freshness, or correctness risks introduced by retained state."
            },
            {
              "id": "test_only_execution",
              "evidence_class": "test",
              "description": "Evidence that repetition exists only in tests or fixtures."
            }
          ]
        },
        "claim_slots": [
          "repetition",
          "input_equivalence",
          "mutation_boundary",
          "material_impact",
          "consumer_requirement",
          "wider_owner",
          "invalidation_feasibility",
          "retention_risk",
          "lifecycle_conclusion"
        ],
        "recommendation_families": [
          "lifecycle_reownership",
          "explicit_retention_avoidance",
          "measurement_before_change"
        ]
      }
    },
    {
      "kind": "shared_root_cause",
      "version": 1,
      "status": "shadow",
      "template": {
        "schema_version": 2,
        "kind": "shared_root_cause",
        "version": 1,
        "trigger": {
          "decision_kind": "evaluate_shared_root_cause",
          "selection_reasons_any": ["same_subject_concentration", "cross_layer_intersection"]
        },
        "subject_policy": {
          "minimum_subjects": 1,
          "require_connected": true,
          "allow_multiple_findings": true
        },
        "evidence_contract": {
          "required": [
            {"id": "finding_records", "evidence_class": "finding", "description": "Immutable findings selected for causal comparison."},
            {"id": "subject_neighborhood", "evidence_class": "evidence_graph", "description": "Connected subjects, symbols, and support relationships across the findings."},
            {"id": "source_roles", "evidence_class": "source_role", "description": "Production, test, fixture, tooling, or documentation roles for the affected code."}
          ],
          "optional": [
            {"id": "source_spans", "evidence_class": "source_span", "description": "Hash-validated source excerpts inside the case boundary."},
            {"id": "operator_constraints", "evidence_class": "operator_constraint", "description": "Bound operator constraints relevant to remediation scope and coupling."},
            {"id": "tests", "evidence_class": "test", "description": "Tests that constrain independent failure or lifecycle semantics."}
          ],
          "blocking": [
            {"id": "distinct_semantics", "evidence_class": "consumer_requirement", "description": "Distinct failure, ownership, lifecycle, or consumer semantics that prohibit one root-cause action."},
            {"id": "coupling_constraints", "evidence_class": "operator_constraint", "description": "Constraints showing that a combined remediation would create harmful coupling."}
          ]
        },
        "claim_slots": ["responsibility", "causal_overlap", "independent_actionability", "coupling_risk", "remediation_boundary"],
        "recommendation_families": ["shared_root_remediation", "preserve_independent_actions", "measurement_before_change"]
      }
    },
    {
      "kind": "recommendation_consolidation",
      "version": 1,
      "status": "shadow",
      "template": {
        "schema_version": 2,
        "kind": "recommendation_consolidation",
        "version": 1,
        "trigger": {
          "decision_kind": "reconcile_recommendations",
          "selection_reasons_any": ["recommendation_overlap", "recommendation_conflict"]
        },
        "subject_policy": {
          "minimum_subjects": 1,
          "require_connected": true,
          "allow_multiple_findings": true
        },
        "evidence_contract": {
          "required": [
            {"id": "finding_records", "evidence_class": "finding", "description": "Immutable findings and their detector-local recommendations."},
            {"id": "subject_neighborhood", "evidence_class": "evidence_graph", "description": "Connected subject and support relationships for the affected actions."},
            {"id": "source_roles", "evidence_class": "source_role", "description": "Production, test, fixture, tooling, or documentation roles for the affected code."}
          ],
          "optional": [
            {"id": "source_spans", "evidence_class": "source_span", "description": "Hash-validated source excerpts inside the action boundary."},
            {"id": "runtime_measurements", "evidence_class": "runtime_measurement", "description": "Bound measurements for properties the actions may improve or worsen."},
            {"id": "operator_constraints", "evidence_class": "operator_constraint", "description": "Bound constraints relevant to proportionality, ordering, and deferral."}
          ],
          "blocking": [
            {"id": "consumer_requirements", "evidence_class": "consumer_requirement", "description": "Consumer contracts that make simultaneous actions incompatible."},
            {"id": "retention_constraints", "evidence_class": "retention_constraint", "description": "Constraints that make a combined action unsafe or disproportionate."}
          ]
        },
        "claim_slots": ["compatibility", "abstraction_level", "supersession", "property_conflict", "required_ordering", "proportionality", "deferral"],
        "recommendation_families": ["consolidated_remediation", "sequenced_remediation", "preserve_independent_actions", "narrowed_remediation", "deferred_remediation"]
      }
    }
  ]
}
